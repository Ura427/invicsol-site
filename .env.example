# Postgres connection string (Neon, or any Postgres host). Get one free at
# neon.tech — create a project, then copy the connection string it gives you.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Lead delivery — set these to receive instant notifications.
# Leaving them empty disables the Telegram side effect (the DB write still runs).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

NEXT_PUBLIC_SITE_URL="https://invicsol.com.ua"

# Transactional email (currently only the future admin password-reset flow —
# no public form collects a customer email address). Leaving these empty
# disables the email side effect the same way the Telegram vars do — see
# src/shared/lib/email.ts.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Admin panel (/admin). Generate AUTH_SECRET once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ADMIN_EMAIL/ADMIN_PASSWORD are only read by `npm run admin:create`, which
# seeds the single admin account — there is no public signup route anywhere
# in this app. Safe to remove both from your real .env after running it once.
AUTH_SECRET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
