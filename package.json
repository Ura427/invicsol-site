{
  "name": "invicsol-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "postinstall": "prisma generate",
    "prebuild": "prisma migrate deploy && prisma db seed",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.35.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.26.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.0",
    "prettier": "^3.9.6",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
