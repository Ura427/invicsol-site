generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// LOCALIZATION STRATEGY
/// Base row = facts (numbers, enums, dates, filenames, slugs).
/// Translation row = prose (titles, paragraphs, bullet lists).
///
/// This keeps server-side filtering possible: filters always run against typed
/// columns on the base table, never against a translated string. It also avoids
/// the two schemes we deliberately rejected — suffixed columns (`titleUk`/`titleEn`,
/// a migration per new locale) and locale-keyed rows (locale-neutral facts get
/// duplicated, so fixing a wrong capacity means fixing it twice).
///
/// These columns are kept as `String` with a documented vocabulary rather than
/// native Postgres enums. Every value is still narrowed to a real TypeScript
/// union in `src/entities/<name>/parse.ts` — the single seam where raw rows are
/// validated — and that boundary already gives the same safety a DB enum would,
/// without a migration required every time a station or project vocabulary
/// gains a value, and without the hyphenated values ("grid-tied",
/// "green-tariff") needing to become underscored enum identifiers everywhere
/// they're used — including the /projects URL filter query params.

model Station {
  id     String @id @default(cuid())
  /// "5kw" | "10kw" | "15kw" | "30kw" | "custom"
  slug   String @unique
  /// Nominal power. Null only for the bespoke "custom" configuration card.
  powerKw Float?
  /// "grid-tied" | "hybrid" | "custom"
  systemType String
  /// "default" | "gold" — the custom card is styled distinctly.
  accent     String @default("default")
  /// Display order in the catalogue grid.
  sortOrder  Int
  imagePath  String
  /// Launch blocker: placeholder rows must be replaced with real content.
  isPlaceholder Boolean @default(false)

  /// COMMERCIAL FIELDS — all nullable, all editable from the admin panel.
  /// The price is for the EQUIPMENT KIT only. Installation is published as a
  /// range rather than folded into one number, because it genuinely varies
  /// with roof type, cable runs and the state of the incoming service — a
  /// single turnkey figure would be the "beautiful but untrue" number the FAQ
  /// argues against, and an equipment-only price with no installation context
  /// would be the same trick in the other direction.
  priceEquipmentUah  Int?
  priceInstallMinUah Int?
  priceInstallMaxUah Int?
  /// Null means "not stated". Never claim stock for equipment that is not
  /// actually held or reliably sourceable.
  inStock            Boolean?
  ratingValue        Float?
  ratingCount        Int?
  /// LAUNCH BLOCKER. True while ANY commercial field above holds a demo value.
  /// While set, the UI renders a visible placeholder badge beside the price and
  /// rating, so fabricated figures cannot ship silently as real ones. Flip to
  /// false per station only when every value above is genuine.
  commercialIsPlaceholder Boolean @default(true)

  translations StationTranslation[]

  @@index([sortOrder])
}

model StationTranslation {
  id        String @id @default(cuid())
  stationId String
  /// "uk" | "en"
  locale    String

  badge String
  title String
  intro String

  /// String arrays, stored as native Postgres jsonb — validated (never trusted
  /// blindly) in entities/station/parse.ts. SQLite forced these into
  /// JSON-in-a-string columns; Postgres doesn't need that workaround.
  suitableFor Json
  outcomes    Json
  kitMain     Json
  kitExtra    Json
  benefits    Json

  specPurpose     String
  specScalability String

  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([stationId, locale])
  @@index([locale])
}

model Project {
  id   String @id @default(cuid())
  slug String @unique

  /// Locale-neutral, filterable facts. The vocabularies below are kept
  /// IDENTICAL to the calculator wizard's own state unions, so a calculator
  /// answer can deep-link into a filtered projects list of similar work.
  capacityKw  Float
  /// "house" | "business"
  objectType  String
  /// "self" | "green-tariff" | "hybrid-backup"
  usage       String
  /// "roof" | "ground"
  mountType   String
  /// Locale-neutral key resolved to a translated city name in messages/*.json.
  locationKey String
  completedAt DateTime

  coverImage String
  /// Launch blocker: invented case studies must never ship as real work.
  isPlaceholder Boolean @default(false)

  translations ProjectTranslation[]
  images       ProjectImage[]

  @@index([objectType])
  @@index([usage])
  @@index([capacityKw])
  @@index([completedAt])
}

model ProjectTranslation {
  id        String @id @default(cuid())
  projectId String
  /// "uk" | "en"
  locale    String

  title     String
  summary   String
  challenge String
  solution  String
  result    String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
  @@index([locale])
}

model ProjectImage {
  id        String @id @default(cuid())
  projectId String
  path      String
  sortOrder Int

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sortOrder])
}

model Lead {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// "calculator" | "contact" | "callback"
  source        String
  name          String
  phone         String
  /// "phone" | "viber" | "telegram"
  contactMethod String
  locale        String

  /// The full submission, stored verbatim as JSON rather than normalised into
  /// columns: a lead is an immutable record of what was submitted at that
  /// moment, is never queried field-by-field, and the wizard's shape will evolve.
  payload String

  /// Set once the Telegram notification has been delivered. A null value on a
  /// row is the signal that the durable side effect did not fire.
  notifiedAt DateTime?

  /// Set by the admin leads inbox once someone has followed up. A separate
  /// timestamp rather than a boolean, for the same reason notifiedAt is one —
  /// "when" is more useful than "whether" once you're looking back at a list.
  handledAt DateTime?

  @@index([createdAt])
}

/// Exactly one row is expected to ever exist. There is no public signup route
/// anywhere in the app — this table is populated only by the seed script at
/// scripts/create-admin.ts, run once, by hand, by the site owner.
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

/// DB-backed, same reasoning as Station/Project: an editorial library that
/// grows over time belongs in the database, not the typed content.ts system
/// (which is for fixed, non-filterable content — a why-us grid, not a
/// library of posts that will eventually need its own admin CRUD).
model Article {
  id          String   @id @default(cuid())
  slug        String   @unique
  publishedAt DateTime
  coverImage  String

  translations ArticleTranslation[]

  @@index([publishedAt])
}

model ArticleTranslation {
  id        String @id @default(cuid())
  articleId String
  /// "uk" | "en"
  locale    String

  title   String
  excerpt String

  /// An array of content blocks, stored as jsonb — validated in
  /// entities/article/parse.ts, same pattern as Station's equipment lists.
  /// A block starting with "## " renders as a subheading, otherwise as a
  /// paragraph — the same lightweight in-string markup convention already
  /// used elsewhere in this project (next-intl's t.rich for <em> highlights),
  /// rather than reaching for a full rich-text editor for three articles.
  body Json

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@index([locale])
}
